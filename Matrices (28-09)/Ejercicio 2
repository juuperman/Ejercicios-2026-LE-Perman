#include <stdio.h>

int main() {
    int tabla[4][4];

    int entradas[4][2] = {
        {0, 0},
        {0, 1},
        {1, 0},
        {1, 1}
    };

    for (int i = 0; i < 4; i++) {
        int a = entradas[i][0];
        int b = entradas[i][1];

        tabla[i][0] = a;          
        tabla[i][1] = b;           
        tabla[i][2] = a && b;     
        tabla[i][3] = a || b;     
    }

    printf("| A | B | A AND B | A OR B |\n");

    for (int i = 0; i < 4; i++) {
        printf("| %d | %d |    %d    |   %d    |\n", 
                tabla[i][0], 
                tabla[i][1], 
                tabla[i][2], 
                tabla[i][3]);
    }

    return 0;
}
