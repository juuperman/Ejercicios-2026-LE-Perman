//Crear un código que una vez indicados los datos que almacena un vector, sume todos sus datos y los imprima.
//-Una vez realizado, calcule el promedio de esos datos. 

#include <stdio.h>
int main()
{
    int suma=0;
    float promedio;
    int vector[4];
    for(int i=0;i<4;i++){
        printf("Ingrese el valor deseado para la posición número %d\n", i);
        scanf("%d", &vector[i]);
        suma +=vector[i];
    }
    promedio=suma/4;
    printf("La suma es %d y el promedio es %.2f\n", suma, promedio);
    
    return 0;
}
