#include <stdio.h>

int main() {
    int v[5];
    int op, pos;

   printf("Ingresa 5 valores:\n");
    for(int i = 0; i < 5; i++) {
        printf("Posicion %d: ", i);
        scanf("%d", &v[i]);
    }

    while(1) {
        printf("1. Ver vector  2. Modificar  3. Salir\nElige una opcion: ");
        scanf("%d", &op);

        if(op == 1) {
            for(int i = 0; i < 5; i++) {
                printf("v[%d] = %d\n", i, v[i]);
            }
        }
        else if(op == 2) {
            printf("Posicion a modificar (0-4): ");
            scanf("%d", &pos);
            if(pos >= 0 && pos < 5) {
                printf("Nuevo valor: ");
                scanf("%d", &v[pos]);
            } else {
                printf("Posicion invalida.\n");
            }
        }
        else if(op == 3) {
            break;
        }
    }

    return 0;
}
