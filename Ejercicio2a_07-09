#include <stdio.h>
int vector[4];
int x, suma;
float promedio; 

int main()
{
    for(x=0; x<4; x++){
        printf("Indique el numero a guardar: ");
        scanf("%d", &vector[x]);
        suma += vector[x];
    }
    
    promedio = suma /4; 
    printf("La suma es: %d\n", suma);
    printf("El promedio es: %.2f\n", promedio); 
    return 0;
}
