#include <stdio.h>

int main() {
    int matriz[3][2];

    printf("Ingresa los datos para la matriz 3x2:\n");

    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 2; j++) {
            printf("Posición [%d][%d]: ", i, j);
            scanf("%d", &matriz[i][j]);
        }
    return 0;
}

