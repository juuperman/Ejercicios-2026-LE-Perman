#include <stdio.h>

int main() {
    int matriz[3][2][2];

    printf("Ingresa los datos para la matriz 3D (3x2x2):\n");

    for (int k = 0; k < 3; k++) {         
        for (int i = 0; i < 2; i++) {      
            for (int j = 0; j < 2; j++) {  
                printf("Posición [%d][%d][%d]: ", k, i, j);
                scanf("%d", &matriz[k][i][j]);
            }
        }
    }

    return 0;
}
